<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ launch screen at night: no full-screen blue flash. The dark surface, with the
     bus on a blue disc. (Needed: values-night outranks values-v31, so night needs its own.) -->
<resources>
    <style name="Theme.TransitPlanner" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand</item>
    </style>
</resources>
